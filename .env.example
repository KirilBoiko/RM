# Copy to .env if running standalone CLI batch (`uv run rm-advise`)
# Note: Claude Code reads ANTHROPIC_API_KEY from your shell or `/login` session automatically.

# LLM Provider for `uv run rm-advise`: deterministic | anthropic | ollama | vllm
RM_LLM_PROVIDER=deterministic

# Anthropic settings (when RM_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
RM_ANTHROPIC_MODEL=claude-sonnet-4-5

# Local LLM settings (when RM_LLM_PROVIDER=ollama or vllm)
RM_LOCAL_BASE_URL=http://localhost:11434/v1
RM_LOCAL_MODEL=qwen2.5:14b
